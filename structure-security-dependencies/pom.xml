            <email>15524415221@163.com</email>
        </developer>
        <developer>
            <id>lchqJava</id>
            <name>Chuanqiang Liu</name>
            <email>361648887@qq.com</email>
        </developer>
    </developers>

    <issueManagement>
        <system>Github</system>
        <url>https://github.com/structure-projects/structure-security/issues</url>
    </issueManagement>

    <scm>
        <url>https://github.com/structure-projects/structure-security</url>
        <connection>scm:git:git://github.com/structure-projects/structure-security.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:structure-projects/structure-security.git</developerConnection>
    </scm>


    <properties>
        <revision>1.1.5-SNAPSHOT</revision>
        <structure.version>1.4.2</structure.version>
        <spring-boot.version>4.0.6</spring-boot.version>
        <jjwt.version>0.12.7</jjwt.version>
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <jakarta.annotation.version>2.1.1</jakarta.annotation.version>
        <lombok.version>1.18.30</lombok.version>
        <!-- jdk -->
        <charset>UTF-8</charset>
        <encoding>UTF-8</encoding>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>${charset}</project.build.sourceEncoding>

        <!--maven-->
        <maven-plugin.version>3.8.1</maven-plugin.version>

        <maven-project-info-reports-plugin.version>3.0.0</maven-project-info-reports-plugin.version>
        <maven-site-plugin.version>3.7.1</maven-site-plugin.version>
        <maven-compiler-plugin.version>3.8.1</maven-compiler-plugin.version>
        <maven-source-plugin.version>2.2.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.6.3</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>1.5</maven-gpg-plugin.version>
        <cobertura-maven-plugin.version>2.7</cobertura-maven-plugin.version>
        <maven-flatten-maven-plugin.version>1.2.7</maven-flatten-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.9.0</central-publishing-maven-plugin.version>
        <springdoc-openapi-starter-webmvc-api.version>2.3.0</springdoc-openapi-starter-webmvc-api.version>
    </properties>

    <modules>
        <module>../structure-security-core</module>
        <module>../structure-security-permission-starter</module>
        <module>../structure-security-jwt-starter</module>
        <module>../structure-security-basicauth-starter</module>
        <module>../structure-security-common</module>
        <module>../structure-security-oauth-sdk</module>
        <module>../structure-security-oauth-common</module>
        <module>../structure-security-oauth-resource-starter</module>
        <module>../structure-security-context-starter</module>
