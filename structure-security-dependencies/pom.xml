    <name>structure-security-dependencies</name>
    <description>structure-security-dependencies</description>
    <artifactId>structure-security-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <url>https://projects.structured.cn/structure-boot</url>
    <inceptionYear>2021</inceptionYear>
    <organization>
        <name>structure</name>
